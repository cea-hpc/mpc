	CMAKE_OPTS="$CMAKE_OPTS -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
fi

# we want parameter expansion
checking "Configuring MPC with CMake"
wrap_output cmake -S "$SCRIPTPATH" -B "${PROJECT_BUILD_DIR}" $CMAKE_OPTS
ok

checking "Building MPC"
wrap_output cmake --build "${PROJECT_BUILD_DIR}" -- -j ${MAKE_J}
ok

checking "Installing MPC"
wrap_output cmake --install "${PROJECT_BUILD_DIR}"
ok

if test "x${LSP}" = "xyes"; then
	checking "Copying compile_commands.json to the source directory"
	wrap_output cp "${PROJECT_BUILD_DIR}/compile_commands.json" "${SCRIPTPATH}"
	ok
fi
