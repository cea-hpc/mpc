		--disable-ofi|--disable-libfabric)
			OFI_PREFIX="disabled"
			add_cmake_opt "-DMPC_ENABLE_OFI=OFF"
			;;
		#### BXI ##########
		--with-bxi)
			add_cmake_opt "-DMPC_BXI_VERSION=2"
			;;
		--with-bxi=*)
			extractParamValue 'BXI_PREFIX' 'with-bxi' "$arg"
			add_cmake_opt "-DMPC_BXI_VERSION=${BXI_PREFIX}"
			;;
		--ofi=*)
			extractAndAddPackageOption 'OFI_BUILD_PARAMETERS' 'ofi=' "$arg"
			;;
		#### MPC Allocator ##########
		--enable-mpc-allocator|--enable-mpcalloc)
			MPCALLOC_PREFIX=""
			add_cmake_opt "-DMPC_ENABLE_MPCALLOC=ON"
			;;
		--disable-mpc-allocator|--disable-mpcalloc)
			MPCALLOC_PREFIX="disabled"
			add_cmake_opt "-DMPC_ENABLE_MPCALLOC=OFF"
			;;
		--mpcalloc=*)
			# this should probably be setting up MPCALLOC_PREFIX
			extractAndAddPackageOption 'MPCALLOC_BUILD_PARAMETERS' 'mpcalloc=' "$arg"
			add_cmake_opt "-DMPC_ENABLE_MPCALLOC=ON"
			;;
		################### DMTCP ###################
		--with-dmtcp=*)
			extractParamValue 'MPC_DMTCP_PREFIX' 'with-dmtcp' "$arg"
			add_cmake_opt "-DMPC_ENABLE_DMTCP=ON"
			if test -n "${MPC_DMTCP_PREFIX}"; then
				add_cmake_opt "-DMPC_DMTCP_PREFIX=${MPC_DMTCP_PREFIX}"
			fi
			;;
		--dmtcp=*)
			extractAndAddPackageOption 'MPC_DMTCP_BUILD_PARAMETERS' 'dmtcp=' "$arg"
			add_cmake_opt "-DMPC_ENABLE_DMTCP=ON"
			if test -n "${MPC_DMTCP_PREFIX}"; then
				add_cmake_opt "-DMPC_DMTCP_PREFIX=${MPC_DMTCP_PREFIX}"
			fi
			;;
		################### GENERIC FT ###################
		--enable-mpc-ft)
			enableParamIfNot 'MPC_DMTCP_PREFIX' "$MPC_DMTCP_PREFIX" 'disabled' 'internal'
			add_cmake_opt "-DMPC_ENABLE_DMTCP=ON"
			;;
		--disable-mpc-ft)
			MPC_DMTCP_PREFIX="disabled"
			;;
		################# COMPILER ##################
		--compiler=*)
			extractParamValue 'MPC_COMPILER' 'compiler' "$arg"
			ALL_PACKAGE_ARGS="$ALL_PACKAGE_ARGS CC=${MPC_COMPILER}"
			;;
		############### MPCFRAMEWORK ################
		--enable-color)
			MPC_COMP_ADD_BUILD_PARAMETERS="${MPC_COMP_ADD_BUILD_PARAMETERS} --opts=--enable-color"
			USE_COLOR="yes"
			add_cmake_opt "-DMPC_ENABLE_SHELL_COLORS=ON"
			;;
		--disable-color)
			MPC_COMP_ADD_BUILD_PARAMETERS=$(echo "$MPC_COMP_ADD_BUILD_PARAMETERS"  | sed "s/--opts=--enable-color//")
			USE_COLOR="no"
			add_cmake_opt "-DMPC_ENABLE_SHELL_COLORS=OFF"
			;;
		--enable-debug)
			enable_debug
			;;
		--debug)
			enable_debug
			;;
		--relwithdebinfo)
			MPC_OPTIM_OPTION_SPECIFIED="yes"
			enable_real_with_debug
			;;
		--enable-topology-simulation)
			add_cmake_opt "-DMPC_ENABLE_TOPOLOGY_SIMULATION=ON"
			;;
		--with-pmi1=*)
			PMI1_PREFIX=""
			extractParamValue 'PMI1_PREFIX' 'with-pmi1=' "$arg"
			ENABLE_SLURM='no'
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMI1"
			if test -n "${PMI1_PREFIX}"; then
				add_cmake_opt "-DMPC_PMI_PREFIX=${PMI1_PREFIX}"
			fi
			;;
		--with-pmi1)
			ENABLE_SLURM='no'
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMI1"
			;;
		--with-pmix=*)
			PMIX_PREFIX=""
			extractParamValue 'PMIX_PREFIX' 'with-pmix=' "$arg"
			ENABLE_SLURM='no'
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMIX"
			if test -n "${PMIX_PREFIX}"; then
				add_cmake_opt "-DMPC_PMIX_PREFIX=${PMIX_PREFIX}"
			fi
			;;
		--with-pmix)
			ENABLE_SLURM='no'
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMIX"
			;;
		--with-prrte)
			ENABLE_SLURM='no'
			have_prte
			if [ "${HAVE_CMD}" == "no" ]; then
				die "--with-prrte: neither prterun nor prun was found in path"
			fi
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMIX -DMPC_LAUNCHER_PROGRAM=PRRTE"
			;;
		--with-slurm=*)
			SLURM_PREFIX=""
			extractParamValue 'SLURM_PREFIX' 'with-slurm=' "$arg"
			SLURM_REQUESTED="yes"
			;;
		--with-slurm)
			SLURM_REQUESTED="yes"
			;;
		--disable-MPC_MPI|--lib-mode|--disable-mpi)
			add_cmake_opt "-DMPC_ENABLE_MPI=OFF"
			;;
        --disable-openshmem)
			add_cmake_opt "-DMPC_ENABLE_OPENSHMEM=OFF"
            ;;
		--disable-romio)
			add_cmake_opt "-DMPC_ENABLE_MPIIO=OFF"
			;;
		--disable-lowcomm)
			add_cmake_opt "-DMPC_ENABLE_LOWCOMM=OFF"
			;;
		--disable-threads)
			add_cmake_opt "-DMPC_ENABLE_THREADS=OFF"
			;;
		--disable-openmp)
			add_cmake_opt "-DMPC_ENABLE_OPENMP=OFF"
			;;
		--enable-profiler)
			add_cmake_opt "-DMPC_ENABLE_PROFILER=ON"
			;;
		--disable-prefix-check|--disable-check-install)
			info "$arg is a no-op, it is only kept for command line compatibility"
			;;
		--mpcframework=*)
			# Pass extra options to MPC, resolved once the backend is known
			extractAndAddPackageOption 'MPC_USER_BUILD_PARAMETERS' 'mpcframework=' "$arg"
			;;
		--mpc-option=*)
			extractAndAddPackageOption 'MPC_USER_BUILD_PARAMETERS' 'mpc-option=' "$arg"
			;;
		################## COMMON ###################
		-v | --verbose | --verbose=1)
			STEP_WRAPPER_VERBOSE=1
			export STEP_WRAPPER_VERBOSE
			;;
		-vv | --verbose=2)
			STEP_WRAPPER_VERBOSE=2
			export STEP_WRAPPER_VERBOSE
			;;
		-vvv | --verbose=3)
			STEP_WRAPPER_VERBOSE=3
			export STEP_WRAPPER_VERBOSE
			;;
		-j*)
			extractParamValueAlt 'MAKE_J' 'j' "$arg"
			;;
		--prefix=*)
			extractParamValue 'PREFIX' 'prefix' "$arg"
			if [ ! -d "${PREFIX}" ]; then
				mkdir -p "${PREFIX}"
			else
				check_prefix_is_clean "${PREFIX}"
			fi
			;;
		--help|-h|-?)
			showHelp
			exit 0
			;;
		--download|--download-missing-deps)
			download_all_missing_deps
			exit 0
		;;
		--enable-lsp)
			LSP="yes"
			;;
		--disable-lsp)
			LSP="no"
			;;
		--spack|--enable-spack)
			assert_cmd "spack"
			SPACK_LOCATE_DEPENDENCY="yes"
			;;
		--disable-spack|--enable-all-internals)
			SPACK_LOCATE_DEPENDENCY="no"
			SPACK_INSTALL_DEPENDENCY="no"
			;;
		--spack-build|--enable-spack-build)
			assert_cmd "spack"
			SPACK_LOCATE_DEPENDENCY="yes"
			SPACK_INSTALL_DEPENDENCY="yes"
			;;
		--disable-spack-build)
			SPACK_INSTALL_DEPENDENCY="no"
			;;
		--enable-spack-arch)
			SPECIFY_SPACK_ARCH="yes"
			;;
		--disable-spack-arch)
			SPECIFY_SPACK_ARCH="no"
			;;
		--enable-generic-spack-build)
			ENABLE_GENERIC_SPACK_BUILD="yes"
			;;
		--disable-generic-spack-build)
			ENABLE_GENERIC_SPACK_BUILD="no"
			;;
		--force-spack-arch=*)
			extractParamValue 'FORCE_SPACK_ARCH' 'force-spack-arch' "$arg"
			;;
		--disable-build)
			BUILD_IS_DISABLED="yes"
			;;
		--force-spack-package=*)
			extractParamValue 'OVERRIDDEN_SPACK_PKGS' 'force-spack-package' "$arg"
			;;
    	--enable-workshare)
			WORKSHARE_ENABLED="yes"
			add_cmake_opt "-DMPC_ENABLE_WORKSHARE=ON"
			# Workshare is only on 7.3.0 try to force it
			GCC_VERSION="7.3.0"
      	;;
		# Build wrappers
		--version)
			printf "%s\n" "$("$SCRIPTPATH/config/mpc_get_version.sh" --all)"
			exit 0
			;;
		clean)
			# Deferred until the backend is known (see below)
			DO_CLEAN="yes"
			;;
		distclean)
			# Deferred until the backend is known (see below)
			DO_DISTCLEAN="yes"
			;;
		# Deprecated options
		--mirror=*|--with-sctk-arch=*|--sctk-arch-*|--with-mpfr=*|--mpfr-*|--with-gmp=*|--with-hbict=*|--hbict-*|--gmp-*|--with-mpc-binutils=*|--mpc-binutils-*|--disable-mpc-binutils|--with-libextls=*|--libextls-*|--with-mpc=*|--enable-check-deps|--disable-check-deps|--host=*|--target=*|--arch-library-path=*|--with-sysroot=*|--with-libxml2=*|--libxml2=*)
			info "$arg is deprecated"
			;;
		*)
			echo "Invalid argument '$arg', please check your command line or get help with --help." 1>&2
			exit 1
	esac
done

#
# Deferred argument handling
#

# Resolve --mpc-option= / --mpcframework= values
# The CMake backend only accepts the whitelisted module toggles
if test -n "${MPC_USER_BUILD_PARAMETERS}"; then
	for mpc_user_opt in ${MPC_USER_BUILD_PARAMETERS}; do
		translate_mpc_user_option_to_cmake "${mpc_user_opt}"
	done
fi

# Handle clean / distclean
if test "x${DO_CLEAN}" = "xyes"; then
	cmake --build "${PROJECT_BUILD_DIR}" --target clean
fi

if test "x${DO_DISTCLEAN}" = "xyes"; then
	if test "x${PROJECT_BUILD_DIR}" = "x${SCRIPTPATH}"; then
		die "Refusing to distclean the MPC source directory"
	fi

	rm -fr "${PROJECT_BUILD_DIR}"
fi

#
# Enable output color if set
#
set_color_model

# Build directory check
#

# Make sure we do not install inside the source directory

if test "x${SCRIPTPATH}" = "x${PROJECT_BUILD_DIR}"; then
	die "MPC cannot be configured inside the source directory"
fi


# Make sure we have a prefix
test -z "$PREFIX" && die "Please provide a prefix where to install MPC"

PREFIX=$(readlink -f "$PREFIX")

if test "x${PREFIX}" = "x${PROJECT_BUILD_DIR}"; then
	die "You cannot install MPC in its build directory"
fi

# Ensure cores used to build is configured

if test -z "$MAKE_J"; then
	guess_cpu_count

	info "Building with ${NCPU} cores use -jX to change"
	MAKE_J="$NCPU"
