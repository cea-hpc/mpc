#
# Build CMake options from installmpc variables
# Options set during arg parsing are already in CMAKE_OPTS.
# This section only handles CMake specifics like CMAKE_BUILD_TYPE, CMAKE_*_COMPILER & CMAKE_PREFIX_PATH.
#
CMAKE_OPTS="-DCMAKE_INSTALL_PREFIX=${PREFIX} $CMAKE_OPTS"

# --- Build type / optimization defaults ---
if test "${DEBUG}" = "yes"; then
	CMAKE_OPTS="$CMAKE_OPTS -DCMAKE_BUILD_TYPE=Debug"
elif test "${MPC_OPTIM_OPTION_SPECIFIED}" = "yes"; then
	CMAKE_OPTS="$CMAKE_OPTS -DCMAKE_BUILD_TYPE=RelWithDebInfo"
else
	CMAKE_OPTS="$CMAKE_OPTS -DCMAKE_BUILD_TYPE=Release -DMPC_ENABLE_OPT_NATIVE=ON"
fi

# --- Compiler (mpc-compiler-additions / autopriv) ---
if test "${MPC_COMP_ADD_PREFIX}" != "disabled"; then
	CMAKE_OPTS="$CMAKE_OPTS -DCMAKE_C_COMPILER=$(command -v apcc) -DCMAKE_CXX_COMPILER=$(command -v ap++) -DCMAKE_Fortran_COMPILER=$(command -v apfortran)"
	CMAKE_OPTS="$CMAKE_OPTS -DMPC_ENABLE_PROCESS_MODE=OFF"
else
		# No mpc-compiler-additions: let CMake try extls first, fall back to process mode
		# Don't override MPC_ENABLE_PROCESS_MODE — CMakeLists.txt default (OFF) + extls detection handles it
		:
