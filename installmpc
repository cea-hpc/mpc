add_cmake_opt()
{
	CMAKE_OPTS="$CMAKE_OPTS $1"
}

#
# Translate an option given through --mpc-option= / --mpcframework= for the
# CMake backend. Only the whitelisted module toggles are translated, any
# other value is rejected with an explicit error, hinting at the named
# installmpc flag when one exists.
#

translate_mpc_user_option_to_cmake()
{
	case "$1" in
		--disable-lowcomm)
			add_cmake_opt "-DMPC_ENABLE_LOWCOMM=OFF"
			;;
		--disable-mpi)
			add_cmake_opt "-DMPC_ENABLE_MPI=OFF"
			;;
		--disable-threads)
			add_cmake_opt "-DMPC_ENABLE_THREADS=OFF"
			;;
		--disable-openmp)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-openmp flag"
			;;
		--enable-profiler)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --enable-profiler flag"
			;;
		--disable-mpiio)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-romio flag"
			;;
		--disable-openshmem)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-openshmem flag"
			;;
		--disable-fortran)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-fortran flag"
			;;
		--disable-mpc-allocator)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-mpcalloc flag"
			;;
		--enable-workshare)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --enable-workshare flag"
			;;
		--enable-topology-simulation)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --enable-topology-simulation flag"
			;;
		--with-dmtcp)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --enable-mpc-ft flag"
			;;
		--enable-shell-colors)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --enable-color flag"
			;;
		--disable-shell-colors)
			die "--mpc-option/--mpcframework: '$1' is not supported by the CMake backend, use the --disable-color flag"
			;;
		*)
			die "--mpc-option/--mpcframework only supports --disable-lowcomm, --disable-mpi and --disable-threads with the CMake backend (got '$1'), use a named installmpc flag (see --help) or pass CMake cache variables directly"
			;;
	esac
}

set_cuda_on()
{
	add_cmake_opt "-DMPC_ENABLE_CUDA=ON"
	if test -n "$1"; then
		CUDA_PREFIX="$1"
		add_cmake_opt "-DMPC_CUDA_PREFIX=${CUDA_PREFIX}"
	fi
}

set_rocm_on()
{
	add_cmake_opt "-DMPC_ENABLE_ROCM=ON"
	if test -n "$1"; then
		ROCM_PREFIX="$1"
		add_cmake_opt "-DMPC_ROCM_PREFIX=${ROCM_PREFIX}"
	fi
}

set_rocm_nvidia_on()
{
	set_cuda_on ""
	set_rocm_on "$1"
	add_cmake_opt "-DMPC_ROCM_MOD=nvidia"
}

#
# Output MGT
#

# Print an error message and exit
# Args:
# -$1 : Message to print
die(){
	echo "================ ERROR ================"
	echo "$1"
	echo "======================================="
	exit 1
}

#
# Check call return code
# Args:
# - $1: retcode to check
# - $2: error if NOK (no error if not given)
check_retcode()
{
	if test "x$1" = "x0"; then
		ok
	else
		nok
		if test -n "$2"; then
			die "$2"
		fi
	fi
}

#
# Ensures the prefix has not been emptied
# and remove marker file if so
# Args:
# - $1: prefix to check
#
check_prefix_is_clean()
{
	if test -d "$PREFIX/lib/" -a -d "$PREFIX/bin/"; then
		return
	else
		# Apparently prefix was cleared somehow
		# Make sure deps are reinstalled
		rm -fr "$PREFIX"/.mpc-installed-*
		info "Prefix seems to be incomplete, forcing reinstall."
	fi
}

