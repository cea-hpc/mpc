PENDING_LB=""
STEP_WRAPPER_VERBOSE=0

show_run_cmd()
{
	if test $STEP_WRAPPER_VERBOSE -gt 1; then
		test -n "${PENDING_LB}" && echo ""
		PENDING_LB=""
		echo "$ $*"
	fi
}


#Print a debug messages if the level of verbosity is 3 or higher
#Args :
# -$1 : Message to print
debug()
{
	if [ $STEP_WRAPPER_VERBOSE -gt 2 ]; then
		printf "${colGRAY}[debug] $1${colRESET}\n"
	fi
}

info()
{
	if [ $STEP_WRAPPER_VERBOSE -gt 0 ]; then
		printf "==>${colGRAY} $1${colRESET}\n"
	fi
}

LAST_RESULT=""
LOTS_OF_DOTS="................................................................."

checking() {
	LAST_RESULT=""
	PENDING_LB="yes"

	local msg="$1"
	local msg_length=${#msg}
	local dot_len=3

	if [ "$msg_length" -le 63 ]; then
		dot_len=$((66 - msg_length))
	fi
	printf "==>${colMAGENTA} %s%s ${colRESET}" "${msg}" "${LOTS_OF_DOTS:0:$dot_len}"
}

ok()
{
	PENDING_LB=""
	LAST_RESULT="ok"
	if test $STEP_WRAPPER_VERBOSE -le 1; then
		printf "${colGREEN}SUCCESS${colRESET}\n"
	fi
}

nok()
{
	PENDING_LB=""
	LAST_RESULT="nok"
	printf "${UNDERLINE}${colBLINK}${colRED}FAIL${colRESET}\n"
}

skip()
{
	PENDING_LB=""
	LAST_RESULT="skip"
	printf "${UNDERLINE}${colBLINK}${colYELLOW}SKIPPED${colRESET}\n"
}

notapplicable()
{
	PENDING_LB=""
	LAST_RESULT="na"
	printf "${colbgGRAY}NA${colRESET}\n"
}

#
# Check for common commands
#

LIST_OF_FOUND_CMD=""
COMMON_CMD="cmake spack patch cut ls pwd grep rm basename dirname make bzip2 gcc g++ ldd pkg-config mktemp getconf nproc lscpu wget curl mpiexec.hydra srun prterun prun"
check_for_commands()
{
	# Check already done
	test -n "$LIST_OF_FOUND_CMD" && return

	set +e

	for c in $COMMON_CMD; do

		command -v "$c" > /dev/null 2>&1

		if test "x$?" = "x0"; then
			LIST_OF_FOUND_CMD="$LIST_OF_FOUND_CMD $c"
		else
			debug "locate '$c' command in PATH FAILED"
		fi
	done

	set -e
}

have_cmd()
{
	set +e

	echo "$LIST_OF_FOUND_CMD" | grep "$1" > /dev/null 2>&1

	if test "x$?" = "x0"; then
		HAVE_CMD="yes"
	else
		HAVE_CMD="no"
	fi

	set -e
}

assert_cmd()
{
	check_for_commands

	have_cmd "$1"

	if test "x${HAVE_CMD}" = "xno"; then
		checking "$1 is in path"
		nok
		die "$1 could not be found in path"
	fi

}

# Look for the PRRTE launcher program, prterun or its prun alias
have_prte()
{
	have_cmd "prterun"

	if [ "${HAVE_CMD}" == "no" ]; then
		have_cmd "prun"
	fi
}

guess_cpu_count()
{
	checking "Looking for number of CPUs"

	if test -f "/proc/cpuinfo"; then
		show_run_cmd "grep -c processor < /proc/cpuinfo"
		TMP=$(grep -c "processor" < "/proc/cpuinfo" 2>/dev/null)

		if test "x${TMP}" != "x0"; then
			ok
			NCPU="$TMP"
			return
		fi
	fi

	have_cmd "nproc"

	if test "x${HAVE_CMD}" = "xyes"; then
		show_run_cmd "nproc"
		TMP=$(nproc 2> /dev/null || true)

		if test "x${?}" = "x0"; then
			ok
			NCPU="$TMP"
			return
		fi
	fi

	# Could not guess stay serial
	nok
	NCPU="1"
	info "Failed at guessing number of cores use -jX for parallel build"
}

#Extract parameter value and put in given variable
#Args :
# -$1 : Output variable name
# -$2 : parameter name (without --, eg. --with-XXX => 'with-XXX')
# -$3 : User value (--with-XXX=blablable)
extractParamValue()
{
	#extract in local vars
	outputvar="$1"
	name="$2"
	arg="$3"

	value=$(echo "$arg" | sed -e "s/^--${name}=//g")
	eval "${outputvar}=\"${value}\""
}

######################################################
#Extract parameter value and put in given variable
#Args :
# -$1 : Output variable name
# -$2 : parameter name (without -, eg. -XXX)
# -$3 : User value (-XXX=value)
extractParamValueAlt()
{
	#extract in local vars
	outputvar="$1"
	name="$2"
	arg="$3"

	value=$(echo "$arg" | sed -e "s/^-${name}//g")
	eval "${outputvar}=\"${value}\""
}

# Set a var to a value if not already set
#args :
# -$1 : output variable name
# -$2 : value triggering a set
# -$3 : value to set
enableParamIfNot()
{
	#extract in local vars
	outputvar="$1"
	output="$2"
	trigger="$3"
	value="$4"

	if [ "${output}" = "${trigger}" ]
	then
		eval "${outputvar}=\"${value}\""
	fi
}

#Extract parameter value and put in given variable
#Args :
# -$1 : Output variable name
# -$2 : parameter prefix (eg --libxml2-XXXX to add --XXX to libxml2 params)
# -$3 : User value (--libxml2-XXXX)
extractAndAddPackageOption()
{
	#extract in local vars
	outputvar="$1"
	name="$2"
	arg="$3"

	value=$(echo "$arg" | sed -e "s/^--${name}//g")
	eval "${outputvar}=\"\$${outputvar} ${value}\""
}



wrap_output()
{
	assert_cmd "mktemp"

	outfile=$(mktemp)

	set +e

	show_run_cmd "$@"

	if test $STEP_WRAPPER_VERBOSE -eq 3; then
		"$@"
	else
		"$@" > "$outfile" 2>&1
	fi

	if test "x$?" = "x0"; then
		rm "$outfile"
	else
		nok

		if test $STEP_WRAPPER_VERBOSE -gt 0; then
			cat "$outfile"
		fi

		die "See $outfile an error occurred when running $*"
	fi

	set -e
}


