	info "Building with ${MAKE_J} cores"
fi

#
# Can we use spack ? provide information message
#

have_cmd "spack"

if test "x${HAVE_CMD}" = "xyes"; then

	if test "x${SPACK_LOCATE_DEPENDENCY}" = "xno"; then
		info "Not locating packages with spack as --disable-spack was passed"
	else
		# Display warning if not building with spack
		if test "x${SPACK_INSTALL_DEPENDENCY}" = "xno"; then
			info "Not building using spack as --enable-spack-build not passed"
		fi

	fi
else
	info "spack is not present MPC will rely on built-in packages"
fi

#
# These commands are compulsory
#

assert_cmd "make"
assert_cmd "patch"
assert_cmd "bzip2"
assert_cmd "pkg-config"

# Basic dependencies
find_in_prefix_or_use_spack "openpa" "$(package_version "openpa")" "${OPENPA_PREFIX}"

if test "x${DEP_FOUND}" = "xno"; then
	# Could not use spack now installing manually
	build_configure_based_package "openpa" "$(package_version "openpa")" "$OPENPA_BUILD_PARAMETERS"
fi


find_in_prefix_or_use_spack "hwloc" "$(package_version "hwloc")" "${HWLOC_PREFIX}" "-libudev"

if test "x${DEP_FOUND}" = "xno"; then
	# Could not use spack now installing manually
	# hwloc has bugs on inti when building with rocm at least from hwloc 2.7.0 to 2.9.0. the --without-rocm flag make build crash with
	build_configure_based_package "hwloc" "$(package_version "hwloc")" "$HWLOC_BUILD_PARAMETERS"
	HWLOC_PREFIX="${PREFIX}"
fi

# By default, we want to build with slurm support as it is the most spread launcher
if [ "$ENABLE_SLURM" == "yes" ]; then
	have_cmd "srun"

	if [ "${HAVE_CMD}" == "no" ]; then
		if [ "$SLURM_REQUESTED" == "yes" ]; then
			die "--with-slurm: srun was not found in path"
		fi

		# Without Slurm, fall back to PRRTE when available, Hydra otherwise
		ENABLE_SLURM="no"
		have_prte

		if [ "${HAVE_CMD}" == "yes" ] && pkg-config --exists pmix; then
			info "Slurm not found, defaulting to PRRTE"
			add_cmake_opt "-DMPC_PMI_INTERFACE=PMIX"
		else
			info "Slurm not found, defaulting to Hydra"
			HYDRA_PREFIX="enabled"
		fi
	else
		if [ -n "${SLURM_PREFIX}" ]; then
			add_cmake_opt "-DMPC_PMIX_PREFIX=${SLURM_PREFIX}"
		fi
		add_cmake_opt "-DMPC_PMI_INTERFACE=PMIX"
		# An explicit --with-slurm forces srun as the launcher program so
		# that a stray prterun in the PATH cannot take precedence
		if [ "$SLURM_REQUESTED" == "yes" ]; then
			add_cmake_opt "-DMPC_LAUNCHER_PROGRAM=SRUN"
		fi
	fi
fi

