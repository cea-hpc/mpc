	build_configure_based_package "mpcalloc" "$(package_version "mpcalloc")" "$MPCALLOC_BUILD_PARAMETERS"
fi


find_in_prefix_or_use_spack "libfabric" "$(package_version "libfabric")" "$OFI_PREFIX" "fabrics=sockets,tcp,verbs"

