import subprocess
import sys
from argparse import ArgumentParser


def main() -> int:

    mpc_version = "@MPC_VERSION_STRING@"

    # NOTE: The usage is manually defined to incorporated the [--].
    #       It should stay align with the options defined below.
    parser = ArgumentParser(
        prog="oshrun",
        usage="%(prog)s [-hv] [-np num_processes] [--] program [arguments ...]",
        description="Wrapper program to launch OpenSHMEM programs",
        epilog=f"%(prog)s from MPC {mpc_version} Free Software Distributed under CeCILL-C terms",
        allow_abbrev=False,
        add_help=False,
    )

    # Positional binary to launch and options
    positional_group = parser.add_argument_group("Positional arguments")
    positional_group.add_argument("program", action="store", type=str, help="Binary to be launched")
    positional_group.add_argument("arguments", nargs="*", help="Binary arguments")

    # Launching options
    launching_group = parser.add_argument_group("Runner options")
    launching_group.add_argument(
        "-np",
        action="store",
        default=1,
        type=int,
        required=False,
        help="Number of processes (default: 1)",
        metavar="num_processes",
    )

    # Global helping options
    help_group = parser.add_argument_group("General options")
    help_group.add_argument("-h", "--help", action="help")
    help_group.add_argument(
        "-v",
        "--version",
        action="version",
        version=f"%(prog)s from MPC {mpc_version}",
    )

    args = parser.parse_args(sys.argv[1:])

    # Concatenate the mpcrun command
    launch_command: list[str] = ["mpcrun", f"-n={args.np}", args.program, *args.arguments]

    # Launch the binary using mpcrun
    return subprocess.run(launch_command).returncode


if __name__ == "__main__":
    exit(main())
